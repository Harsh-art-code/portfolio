<!DOCTYPE html>
<html>
<head>
    <title>Space Landing Page</title>

    <style>
        body {
            background-color: #0b1026;
            color: white;
            margin: 0;
            font-family: Arial;
        }

        /* Navbar */
        nav {
            background-color: black;
            padding: 20px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        nav a:hover {
            color: orange;
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 80px 20px;
            background-color: #1d2a66;
        }

        h1 {
            font-size: 40px;
        }

        button {
            background-color: orange;
            padding: 12px 25px;
            border: none;
            cursor: pointer;
        }

        /* Features */
        .features {
            text-align: center;
            padding: 40px;
        }

        .card {
            display: inline-block;
            background-color: #141b3d;
            border: 1px solid #2c3873;
            padding: 25px;
            margin: 10px;
            width: 200px;
        }

        .card:hover {
            background-color: #263568;
        }

        /* Contact */
        .contact {
            background-color: #141b3d;
            text-align: center;
            padding: 40px;
        }

        input {
            padding: 10px;
            width: 200px;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: gray;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav>
        <a href="#home">🚀 SpaceX Lite</a>
        <a href="#home">Home</a>
        <a href="#features">Features</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- Hero Section -->
    <div class="hero" id="home">
        <h1>Explore the Universe</h1>

        <p>A simple space themed landing page.</p>

        <h1>🚀 👨‍🚀</h1>

        <button>Get Started</button>
    </div>

    <!-- Features Section -->
    <div class="features" id="features">

        <h2>Our Features</h2>

        <div class="card">
            <h2>⚡</h2>
            <h3>Fast</h3>
            <p>Loads quickly on every device.</p>
        </div>

        <div class="card">
            <h2>📱</h2>
            <h3>Responsive</h3>
            <p>Looks good on mobile and desktop.</p>
        </div>

        <div class="card">
            <h2>🎨</h2>
            <h3>Simple Design</h3>
            <p>Clean and easy to understand.</p>
        </div>

    </div>

    <!-- Contact Section -->
    <div class="contact" id="contact">

        <h2>Join Us</h2>

        <p>Enter your email to stay updated.</p>

        <input type="email" placeholder="Your email">

        <button>Subscribe</button>

    </div>

    <!-- Footer -->
    <footer>
        <p>© 2026 SpaceX Lite</p>
    </footer>

</body>
</html>
