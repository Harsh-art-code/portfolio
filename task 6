<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Array Methods</title>
</head>
<body>

<h2>Version 2: Array Methods (forEach, map, filter, reduce)</h2>

<script>
  var numbers = [5, 12, 8, 21, 3, 16];
  document.write("<p><b>Numbers:</b> " + numbers.join(", ") + "</p>");

  // ---------- 1. forEach: har element pe kaam karo ----------
  document.write("<h3>1. forEach</h3>");
  numbers.forEach(function (num, index) {
    document.write("Index " + index + " : " + num + "<br>");
  });

  // ---------- 2. map: har element ko badal kar NAYA array do ----------
  document.write("<h3>2. map</h3>");
  var doubled = numbers.map(function (num) {
    return num * 2;
  });
  document.write("Double: " + doubled.join(", ") + "<br>");

  // Arrow function se short version
  var squares = numbers.map(num => num * num);
  document.write("Square: " + squares.join(", ") + "<br>");

  // ---------- 3. filter: sirf wo elements jo condition pass karein ----------
  document.write("<h3>3. filter</h3>");
  var evens = numbers.filter(function (num) {
    return num % 2 === 0;
  });
  var big = numbers.filter(num => num > 10);
  document.write("Even numbers: " + evens.join(", ") + "<br>");
  document.write("10 se bade: " + big.join(", ") + "<br>");

  // ---------- 4. reduce: poore array se EK value banao ----------
  document.write("<h3>4. reduce</h3>");
  var total = numbers.reduce(function (sum, num) {
    return sum + num;
  }, 0);                           // 0 = starting value
  var biggest = numbers.reduce((max, num) => num > max ? num : max, numbers[0]);
  document.write("Total: " + total + "<br>");
  document.write("Average: " + (total / numbers.length).toFixed(2) + "<br>");
  document.write("Sabse bada: " + biggest + "<br>");

  // ---------- 5. Students ka real example ----------
  document.write("<h3>5. Students ka data</h3>");
  var students = [
    { name: "Aman",  marks: 78 },
    { name: "Riya",  marks: 92 },
    { name: "Karan", marks: 45 },
    { name: "Neha",  marks: 66 }
  ];

  // forEach: sabhi students dikhao
  students.forEach(function (s) {
    document.write(s.name + " - " + s.marks + "<br>");
  });

  // map: sirf naam ka array
  var names = students.map(s => s.name);
  document.write("<br>Names: " + names.join(", ") + "<br>");

  // filter: pass students (marks >= 50)
  var passed = students.filter(s => s.marks >= 50);
  document.write("Pass: " + passed.map(s => s.name).join(", ") + "<br>");

  // reduce: total aur average marks
  var totalMarks = students.reduce((sum, s) => sum + s.marks, 0);
  document.write("Total marks: " + totalMarks + "<br>");
  document.write("Class average: " + (totalMarks / students.length).toFixed(1) + "<br>");

  // Chaining: pass hue students ke marks ka total
  var passedTotal = students
    .filter(s => s.marks >= 50)
    .map(s => s.marks)
    .reduce((sum, m) => sum + m, 0);
  document.write("Pass students ke marks ka total: " + passedTotal);
</script>

</body>
</html>
