<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Async - setTimeout</title>
<style>
  body { font-family: Arial, sans-serif; background: #f2f4f8; padding: 20px; }
  .box { background: white; max-width: 500px; margin: auto; padding: 20px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
  input { padding: 8px; font-size: 16px; width: 80px; }
  button { padding: 9px 14px; border: none; border-radius: 5px; background: #4a6cf7; color: white; cursor: pointer; }
  #log p { margin: 6px 0; padding: 6px; background: #eef1ff; border-radius: 4px; }
  .error { background: #ffe5e5 !important; color: red; }
  .success { background: #e4f7e4 !important; }
</style>
</head>
<body>

<div class="box">
  <h2>⏳ setTimeout + Callback</h2>

  User ID (1, 2 ya 3):
  <input type="number" id="idInput" value="1">
  <button id="fetchBtn">Fetch Data</button>

  <div id="log"></div>
</div>

<script>
  var idInput  = document.getElementById("idInput");
  var fetchBtn = document.getElementById("fetchBtn");
  var log      = document.getElementById("log");

  // Fake server ka data
  var users = {
    1: { name: "Aman",  city: "Mathura" },
    2: { name: "Riya",  city: "Agra" },
    3: { name: "Karan", city: "Delhi" }
  };

  // Page pe message dikhane wala chhota function
  function addLog(text, type) {
    var p = document.createElement("p");
    p.textContent = text;
    if (type) {
      p.className = type;
    }
    log.appendChild(p);
  }

  // Server se data lana (2 second ka delay)
  // callback: kaam khatam hone ke baad chalne wala function
  function fetchUser(id, callback) {
    setTimeout(function () {
      var user = users[id];

      if (user) {
        callback(null, user);                 // (error nahi, data mila)
      } else {
        callback("User nahi mila!", null);    // (error, data nahi)
      }
    }, 2000);
  }

  fetchBtn.addEventListener("click", function () {
    var id = Number(idInput.value);
    log.innerHTML = "";

    addLog("1. Request bhej di... (server ka wait)");

    // fetchUser ko call kiya, result baad me callback me aayega
    fetchUser(id, function (error, data) {
      if (error) {
        addLog("3. Error: " + error, "error");
      } else {
        addLog("3. Data mil gaya: " + data.name + " (" + data.city + ")", "success");
      }
    });

    // Ye line turant chalti hai, server ka wait nahi karti
    addLog("2. Main kaam chalu hai, data abhi aaya nahi...");
  });
</script>

</body>
</html>
