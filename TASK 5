<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Age Checker - ternary</title>
</head>
<body>

<h2>Age Eligibility Checker (ternary version)</h2>

<script>
  // 1. User se input lena
  var name = prompt("Apna naam likhiye:");
  var age = Number(prompt("Apni age likhiye:"));

  // 2. Valid age hai ya nahi (ternary operator)
  var isValid = (isNaN(age) || age <= 0) ? false : true;

  if (isValid) {
    // Syntax:  condition ? value_if_true : value_if_false
    var result = (age >= 18) ? "ELIGIBLE ✅" : "NOT ELIGIBLE ❌";
    var color  = (age >= 18) ? "green" : "red";

    // Age group nikalne ke liye nested ternary
    var group = (age < 13) ? "Child" : (age < 18) ? "Teenager" : (age < 60) ? "Adult" : "Senior Citizen";

    alert(name + ", aap " + result);

    document.write("<p>Naam: <b>" + name + "</b></p>");
    document.write("<p>Age: <b>" + age + "</b> (" + group + ")</p>");
    document.write("<p style='color:" + color + "'>Status: <b>" + result + "</b></p>");
  } else {
    alert("Galat input! Valid age daliye.");
    document.write("<p style='color:red'>Invalid age entered.</p>");
  }
</script>

</body>
</html>
